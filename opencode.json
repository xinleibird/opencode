{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@xinleibird/bridge-opencode"],
  "default_agent": "plan",
  "lsp": true,
  "formatter": true,
  "mcp": {
    "MiniMax": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/xinleibird/MiniMax-Coding-Plan-MCP.git",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "EXCLUDED_DOMAINS": "csdn.net"
      }
    },
    "tavily": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "tavily-mcp@latest"],
      "environment": {
        "DEFAULT_PARAMETERS": "{\"exclude_domains\": [\"csdn.net\", \"blog.csdn.net\"]}"
      }
    },
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["/Users/xinlei/.local/bin/codebase-memory-mcp"]
    }
  }
}
